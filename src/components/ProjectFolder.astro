---
import { ui, type Language } from "../lib/i18n";
import CardArrow from "./CardArrow.astro";
interface Props {
  project: {
    frontmatter: {
      title: string;
      titleAz?: string;
      descriptionAz?: string;
      description?: string;
      image?: string;
      tech?: string[];
      github: string;
    };
  };
  index: number;
  lang?: Language;
}
const { project, index, lang = "en" } = Astro.props;
const labels = ui(lang);
const { image, tech = [], github } = project.frontmatter;
const title =
  lang === "az"
    ? project.frontmatter.titleAz ||
      project.frontmatter.title
    : project.frontmatter.title;
const description =
  lang === "az"
    ? project.frontmatter.descriptionAz ||
      project.frontmatter.description
    : project.frontmatter.description;
---

<a
  class="project-folder"
  href={github}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${title} — ${labels.newTab}`}
>
  <span class="folder-tab">
    <svg
      viewBox="0 0 24 24"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"><path d="M3 7V5h7l2 3h9v11H3z"></path></svg
    >
    {labels.project} / {String(index + 1).padStart(2, "0")}
  </span>
  <div class="folder-panel">
    <div class="folder-preview">
      <span class="folder-sheet" aria-hidden="true"></span>
      <div class="folder-image">
        <span class="folder-image-bar" aria-hidden="true"
          ><i></i><i></i><i></i></span
        >
        {
          image ? (
            <img src={image} alt="" loading="lazy" decoding="async" />
          ) : (
            <span class="folder-placeholder" aria-hidden="true">
              &lt;/&gt;
            </span>
          )
        }
      </div>
    </div>
    <div class="folder-info">
      <h3>{title}</h3>
      {description && <p>{description}</p>}
      <ul class="folder-tech" aria-label={labels.technologies}>
        {tech.map((t) => <li>{t}</li>)}
      </ul>
      <div class="folder-footer">
        <span class="folder-repository"
          ><svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path
              d="M9 19c-4 1-4-2-6-2m12 5v-4a3.5 3.5 0 0 0-1-3c3-.3 6-1.5 6-5a4 4 0 0 0-1-3c.3-1 .3-2-.1-3-1.5 0-3 1-3 1a11 11 0 0 0-6 0s-1.5-1-3-1c-.4 1-.4 2-.1 3a4 4 0 0 0-1 3c0 3.5 3 4.7 6 5a3.5 3.5 0 0 0-1 3v4"
            ></path></svg
          >
          {labels.repository}</span
        >
        <CardArrow size={34} />
      </div>
    </div>
  </div>
</a>

<style>
  .project-folder {
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: var(--color-text);
    font-family: var(--font-inter);
    transition: transform var(--transition-fast);
  }
  .project-folder:hover {
    transform: none;
  }
  .folder-tab,
  .folder-panel {
    transition: border-color var(--transition-fast);
  }
  .project-folder:hover .folder-tab,
  .project-folder:hover .folder-panel {
    border-color: var(--color-text-muted);
  }
  .project-folder:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 6px;
    border-radius: 12px;
  }
  .folder-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    position: relative;
    z-index: 1;
    padding: 10px 26px 10px 18px;
    border: 1px solid var(--color-border);
    border-bottom: 0;
    border-radius: 16px 24px 0 0;
    background: var(--card-bg);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.05em;
    margin-bottom: -1px;
  }
  .folder-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 22px 20px 18px;
    border: 1px solid var(--color-border);
    border-radius: 0 22px 22px 22px;
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
  }
  .folder-preview {
    position: relative;
    padding-top: 8px;
    margin: 0 4px 22px;
  }
  .folder-sheet {
    position: absolute;
    inset: 0 8px 8px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    border-radius: 10px;
    transform: rotate(-3deg);
    transition: transform var(--transition-normal);
  }
  .folder-image {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    transition: transform var(--transition-normal);
  }
  .folder-image-bar {
    display: flex;
    gap: 4px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--color-border);
  }
  .folder-image-bar i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-text-muted);
    opacity: 0.4;
  }
  .folder-image img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .folder-placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    font-size: 3rem;
    color: var(--color-text-muted);
  }
  .project-folder:hover .folder-sheet {
    transform: translateY(-4px) rotate(-5deg);
  }
  .project-folder:hover .folder-image {
    transform: translateY(-2px) rotate(1deg);
  }
  .folder-info {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .folder-info h3 {
    font-size: var(--text-xl);
    line-height: 1.3;
    margin: 0 0 10px;
    overflow-wrap: anywhere;
  }
  .folder-info p {
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0 0 16px;
  }
  .folder-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: auto 0 18px;
    padding: 0;
  }
  .folder-tech li {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    padding: 4px 10px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
  }
  .folder-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px dashed var(--color-border);
  }
  .folder-repository {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }
  @media (prefers-reduced-motion: reduce) {
    .project-folder,
    .folder-sheet,
    .folder-image {
      transition: none;
    }
    .project-folder:hover,
    .project-folder:hover .folder-sheet,
    .project-folder:hover .folder-image {
      transform: none;
    }
  }
</style>
