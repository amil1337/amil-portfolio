---
import MainLayout from './MainLayout.astro';
const { frontmatter } = Astro.props;
const parsedDate = frontmatter.date ? new Date(frontmatter.date) : undefined;
const date = parsedDate && !Number.isNaN(parsedDate.valueOf()) ? parsedDate : undefined;
---

<MainLayout title={frontmatter.title} bodyClass="blog-theme">
  <article class="section" style="padding-bottom: 150px;">
    <div class="container">
      
      <div style="text-align: center; margin-bottom: 2rem;">
        <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">{frontmatter.title}</h1>
        {date && <p style="color: var(--color-text-muted);">
          Published: <time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
        </p>}
      </div>

      <div class="blog-content">
        <slot />
      </div>
      
    </div>
  </article>
</MainLayout>

<style is:global>
  .blog-content img { display: block; max-width: 100%; height: auto; border-radius: 12px; }
  .blog-content h2 { margin-top: 2rem; margin-bottom: 1rem; font-size: 1.8rem;}
  .blog-content p { margin-bottom: 1.5rem; font-size: 1.1rem; line-height: 1.8; color: var(--color-text);}
  
  .blog-content code { background: var(--color-bg-alt); padding: 0.2rem 0.4rem; border-radius: 4px; font-family: monospace;}
  
  .blog-content pre { padding: 1.5rem; border-radius: 8px; overflow-x: auto; margin-bottom: 1.5rem;}
  
  .blog-content pre code { background: transparent; padding: 0; color: inherit; }
</style>
