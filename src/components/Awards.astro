---
import type { Language } from '../lib/i18n';

interface Props { lang: Language }
const { lang } = Astro.props;
const az = lang === 'az';

const awards = [
  {
    title: az ? 'Dövlət Proqramı qalibi' : 'State Program Winner',
    organization: az ? 'Azərbaycan Respublikasının Elm və Təhsil Nazirliyi' : 'Ministry of Science and Education of the Republic of Azerbaijan',
    logo: '/images/tehsil-nazirliyi-transparent.png',
    description: az
      ? 'Xaricdə ali təhsil üzrə Dövlət Proqramının qalibi olaraq seçilmişəm.'
      : 'Selected as a winner of the State Program for higher education abroad.',
  },
  {
    title: az ? 'Frontend Development — 60% təqaüd' : 'Frontend Development — 60% Scholarship',
    organization: 'DIV Academy',
    logo: '/images/div-academy-square.png?v=2',
    description: az
      ? 'DIV Academy-də Frontend Development təlimi üçün 60% təqaüd qazanmışam.'
      : 'Awarded a 60% scholarship for Frontend Development training at DIV Academy.',
  },
];
---
<section id="awards" class="section awards-section" aria-labelledby="awards-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="awards-heading">{az ? 'Təhsil və nailiyyətlər' : 'Education & Achievements'}</h2>
      <div class="section-divider"></div>
    </div>
    <div class="honors-archive">
      <p class="archive-label">{az ? 'Nailiyyətlər və öyrənmə' : 'Recognition & learning'}</p>
      <ol class="honors-list">
        {awards.map((award, index) => (
          <li class="honor-row" style="align-items: start;">
            <span class="honor-number" style="align-self: start;" aria-hidden="true">0{index + 1}</span>
            <span class:list={["honor-seal", { "div-seal": award.organization === "DIV Academy" }]} style="align-self: start;" aria-hidden="true">
              {award.logo ? <img class:list={{ 'div-tile-image': award.organization === 'DIV Academy' }} src={award.logo} alt="" width="48" height="48" loading="lazy" /> : <svg viewBox="0 0 40 48" width="36" height="44" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"><path d="m12 29-3 15 11-5 11 5-3-15"/><circle cx="20" cy="19" r="14"/><circle cx="20" cy="19" r="10" stroke-dasharray="1 3"/><path d="m20 12 2 4.5 5 .5-3.7 3.2 1.2 4.8-4.5-2.5-4.5 2.5 1.2-4.8L13 17l5-.5Z"/></svg>}
            </span>
            <div class="honor-details">
              <h3>{award.title}</h3>
              <p class="honor-organization">{award.organization}</p>
              <p class="honor-description">{award.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <div class="honors-archive education-archive">
      <p class="archive-label">{az ? 'Təhsil' : 'Education'}</p>
      <ol class="honors-list">
        {[
          {
            title: az ? 'Bilkent Universiteti' : 'Bilkent University',
            logo: '/images/bilkent-transparent.png',
            subtitle: az ? 'Kompüter mühəndisliyi · Hazırda təhsil alıram' : 'Computer Engineering · Currently studying',
            description: az ? 'Kompüter mühəndisliyi üzrə ikinci kurs tələbəsiyəm.' : 'Second-year Computer Engineering student.',
          },
          {
            title: az ? 'Fizika, Riyaziyyat və İnformatika təmayüllü lisey' : 'Physics, Mathematics and Informatics Lyceum',
            logo: '/images/fritl-transparent-v2.png',
            subtitle: az ? 'Orta təhsil · Bakı, Azərbaycan' : 'Secondary education · Baku, Azerbaijan',
            description: az ? 'Orta təhsilimi fizika, riyaziyyat və informatika təmayüllü liseydə almışam.' : 'Attended a lyceum specializing in physics, mathematics and informatics for my secondary education.',
          },
        ].map((school, index) => (
          <li class="honor-row" style="align-items: start;">
            <span class="honor-number" style="align-self: start;" aria-hidden="true">0{index + 1}</span>
            <span class="honor-seal" style="align-self: start;" aria-hidden="true">
              {school.logo ? <img class:list={["school-logo", { "fritl-logo": school.logo.includes("fritl") }]} src={school.logo} alt="" width="48" height="48" loading="lazy" /> : <svg viewBox="0 0 40 40" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c-5-4-11-4-16-2v24c5-2 11-2 16 2 5-4 11-4 16-2V8c-5-2-11-2-16 2Z"/><path d="M20 10v24M9 14c3-.5 5 0 7 1M9 20c3-.5 5 0 7 1M24 15c2-1 4-1.5 7-1M24 21c2-1 4-1.5 7-1"/></svg>}
            </span>
            <div class="honor-details">
              <h3>{school.title}</h3>
              <p class="honor-organization">{school.subtitle}</p>
              <p class="honor-description">{school.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
  .awards-section { padding-bottom: 4rem; background: var(--color-bg); }
  .awards-section .honors-archive .archive-label { margin: 0 0 16px; color: var(--color-text-muted); font-size: 11px; font-weight: 400; line-height: 1.4; letter-spacing: .08em; text-transform: uppercase; }
  .education-archive { margin-top: 3.5rem; }
  .honors-archive { margin-top: 3rem; }
  .honors-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
  .honor-row { display: grid; grid-template-columns: 24px 48px minmax(0, 1fr); gap: 22px; align-items: start; padding: 26px 8px; border-bottom: 1px solid var(--color-border); transition: background-color .2s; }
  .honor-number { padding-top: 3px; }
  .honor-row:hover { background: var(--color-bg-alt); }
  .honor-number { font-size: .75rem; color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .honor-seal { width: 48px; height: auto; display: grid; place-items: start center; color: var(--color-text); }

  .honor-seal img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; }
  .honor-seal.div-seal { height: auto; aspect-ratio: 1; background: #d0e967; border-radius: 8px; overflow: hidden; padding: 0; }
  .honor-seal img.div-tile-image { width: 100%; height: auto; aspect-ratio: 1; background: transparent; border-radius: 8px; padding: 0; border: 0; object-fit: contain; filter: none; }
  .honor-seal img.school-logo { background: transparent; border-radius: 0; padding: 0; border: 0; }
  .honor-seal img.school-logo.fritl-logo { background: transparent; border-radius: 0; padding: 0; }
  .honor-details h3 { margin: 0 0 6px; font-size: 1.125rem; letter-spacing: -.02em; }
  .honor-details p { margin: 0; font-size: .875rem; }
  .honor-details .honor-organization { font-style: italic; color: var(--color-text-muted); line-height: 1.6; overflow-wrap: anywhere; }
  .honor-details .honor-description { margin-top: 16px; max-width: 58ch; font-size: .9375rem; font-weight: 400; color: var(--color-text); line-height: 1.5; overflow-wrap: anywhere; }
  @media (max-width: 540px) { .honor-row { grid-template-columns: 36px minmax(0, 1fr); gap: 12px; padding: 22px 0; } .honor-number { display: none; } .honor-seal { width: 36px; } .honor-details h3 { font-size: 1rem; } .honor-details p { font-size: .8rem; } }
  @media (prefers-reduced-motion: reduce) { .honor-row { transition: none; } }
</style>
