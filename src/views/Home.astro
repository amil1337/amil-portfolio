---
import { languageFromPath, localPath, ui } from '../lib/i18n';
import AboutAz from '../components/AboutAz.astro';
import MainLayout from '../layouts/MainLayout.astro';
import ProjectFolder from '../components/ProjectFolder.astro';
import BlogCard from '../components/BlogCard.astro';
import Awards from '../components/Awards.astro';
import { existsSync } from 'node:fs';
import { postsForLanguage } from '../lib/posts';

const allProjects = Object.values(import.meta.glob('../projects/*.md', { eager: true })) as any[];
const sortedProjects = allProjects.sort((a, b) => a.frontmatter.order - b.frontmatter.order);
const featuredProjects = sortedProjects.slice(0, 4);
const lang = languageFromPath(Astro.url.pathname);
const labels = ui(lang);
const sortedPosts = await postsForLanguage(lang);
const recentPosts = sortedPosts.slice(0, 3);
const hasCV = existsSync(new URL('../../public/cv.pdf', import.meta.url));
const CVTag = hasCV ? 'a' : 'button';
---

<MainLayout title="Amil's Portfolio">
  <section id="hero" class="section hero-section">
    <div class="container">
      <div class="hero-content">
        <div class="hero-text">
          <h1>{labels.greeting} <span class="highlight">Amil Ibrahimli</span></h1>
          <h2>{labels.role}</h2>
          
          <div class="hero-buttons">
            <a href="#projects" class="button1">
              <span class="button1__icon-wrapper">
                <svg viewBox="0 0 14 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="button1__icon-svg" width="10"><path d="M13.376 11.552l-.264-10.44-10.44-.24.024 2.28 6.96-.048L.2 12.56l1.488 1.488 9.432-9.432-.048 6.912 2.304.024z" fill="currentColor"></path></svg>
                <svg viewBox="0 0 14 15" fill="none" width="10" xmlns="http://www.w3.org/2000/svg" class="button1__icon-svg button1__icon-svg--copy"><path d="M13.376 11.552l-.264-10.44-10.44-.24.024 2.28 6.96-.048L.2 12.56l1.488 1.488 9.432-9.432-.048 6.912 2.304.024z" fill="currentColor"></path></svg>
              </span>
              {labels.work}
            </a>
            <CVTag class="cv-button" href={hasCV ? '/cv.pdf' : undefined} download={hasCV ? 'Amil-Ibrahimli-CV.pdf' : undefined} type={hasCV ? undefined : 'button'} disabled={!hasCV} title={!hasCV ? (lang === 'az' ? 'CV tezliklə əlavə olunacaq' : 'CV will be available soon') : undefined}>
              <svg width="20" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
              {lang === 'az' ? 'CV-ni yüklə' : 'Download CV'}
            </CVTag>
          </div>
        </div>
        <div class="hero-image">
          <div class="profile-image-container">
            <div class="profile-image">
              <img src="/images/3x4.jpg" alt="Amil Ibrahimli" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="section about-section">
    <div class="container">
      <div class="section-header">
        <h2>{labels.about}</h2>
        <div class="section-divider"></div>
      </div>
      <div class="about-content">
        <div class="about-text">
{lang === "az" ? <AboutAz /> : (<Fragment>
          <p>
            Hi, I'm Amil. I am from Baku, Azerbaijan. Right now I'm in the second year of my studies at Bilkent University, in the Computer Engineering department. Before coming to Bilkent, I gained real-world coding experience with frontend development. Using HTML, CSS, and JavaScript, I've built several websites and sold them to customers. I use AI for assistance along the way, while writing the code myself and making sure I understand how it works. Below, you can find some of my projects.
          </p>
          <p>
            Here, at Bilkent, in <a target="_blank" href="https://catalog.bilkent.edu.tr/course/c11101.html" style="color: #007AFF; text-decoration: underline;">CS101</a> and <a target="_blank" href="https://catalog.bilkent.edu.tr/course/c11102.html" style="color: #007AFF; text-decoration: underline;">CS102</a> I had the chance of learning Java Core, OOP Principles, Exception Handling, GUI, Multithreading, etc. By the end of the semester we built a project to demonstrate our skills. Below you will find that project too. Though I still haven't chosen my final career path yet, I believe that learning the Backend could be a good starting point to understand the system and then delve into the other fields of Computer Science.
            That's why I'm learning Spring Boot right now to be more autonomous on writing Backend apps. At the end of the year, I should have completed a summer internship (see: <a target="_blank" href="https://catalog.bilkent.edu.tr/course/c11299.html" style="color: #007AFF; text-decoration: underline;">CS299</a>) in a role that aligns with my degree. I plan to go with Backend Development roles, especially the ones where I can practice and improve my Spring Boot skills.
          </p>
          <p>
            Outside of the classes, I like to touch some grass (literally). I ride my bicycle regularly, except for the days when I get a flat tire from a thorn, and when it happens, fixing it also gives me stimulation and is kind of hobby to take care of my bike. And I go to the gym, except for the days I'm sick. I also used to pet 10 stray cats in Baku, our own home. As you can predict from the previous sentence, 
            I like interacting with animals and I had even volunteered at Baku Zoo before coming to the college for a month. Feel free to reach out me from navbar if you want to chat about programming, hackatons, startups, or just want to swap pictures of stray cats!
          </p>
</Fragment>)}
          <div class="skills-container">
            <h3>{labels.skills}</h3>
            <ul class="skills-list">
              <li>Java</li><li>C++</li><li>OOP</li><li>Multithreading</li>
              <li>Exception Handling</li><li>SQL</li><li>MySQL</li><li>Git</li>
              <li>GitHub</li><li>HTML</li><li>CSS</li><li>Bootstrap</li>
              <li>Tailwind CSS</li><li>JavaScript</li><li>Responsive Layout</li>
              <li>UI/UX Design</li><li>Figma</li><li>Canva</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="projects" class="section projects-section">
    <div class="container">
      <div class="section-header">
        <h2>{labels.featured}</h2>
        <div class="section-divider"></div>
      </div>
      <div class="projects-grid">
        {featuredProjects.map((project, index) => <ProjectFolder project={project} index={index} lang={lang} />)}

      </div>
      <div class="view-more" style="margin-top: 2rem;">
        <a href={localPath(lang, "projects/")} class="button1">
          <span class="button1__icon-wrapper">
            <svg viewBox="0 0 14 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="button1__icon-svg" width="10">
              <path d="M13.376 11.552l-.264-10.44-10.44-.24.024 2.28 6.96-.048L.2 12.56l1.488 1.488 9.432-9.432-.048 6.912 2.304.024z" fill="currentColor"></path>
            </svg>
            <svg viewBox="0 0 14 15" fill="none" width="10" xmlns="http://www.w3.org/2000/svg" class="button1__icon-svg button1__icon-svg--copy">
              <path d="M13.376 11.552l-.264-10.44-10.44-.24.024 2.28 6.96-.048L.2 12.56l1.488 1.488 9.432-9.432-.048 6.912 2.304.024z" fill="currentColor"></path>
            </svg>
          </span>
          {labels.allProjects}
        </a>
      </div>
    </div>
  </section>

  <Awards lang={lang} />

  <section id="recent-blogs" class="section about-section">
    <div class="container">
      <div class="section-header">
        <h2>{labels.recent}</h2>
        <div class="section-divider"></div>
      </div>
      
      <div style="margin-top: 64px;" class="blog-list-container">
        {recentPosts.length ? recentPosts.map((post) => <BlogCard post={post} lang={lang} />) : <p>{labels.noPosts}</p>}
      </div>
      
      <div class="view-more" style="margin-top: 2rem; margin-bottom: 4rem;">
        <a href={localPath(lang, "blog/")} class="button1">
          <span class="button1__icon-wrapper">
             <svg viewBox="0 0 14 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="button1__icon-svg" width="10"><path d="M13.376 11.552l-.264-10.44-10.44-.24.024 2.28 6.96-.048L.2 12.56l1.488 1.488 9.432-9.432-.048 6.912 2.304.024z" fill="currentColor"></path></svg>
             <svg viewBox="0 0 14 15" fill="none" width="10" xmlns="http://www.w3.org/2000/svg" class="button1__icon-svg button1__icon-svg--copy"><path d="M13.376 11.552l-.264-10.44-10.44-.24.024 2.28 6.96-.048L.2 12.56l1.488 1.488 9.432-9.432-.048 6.912 2.304.024z" fill="currentColor"></path></svg>
          </span>
          {labels.allBlogs}
        </a>
      </div>
    </div>
  </section>
</MainLayout>
